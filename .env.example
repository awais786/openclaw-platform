# Copy to .env and fill in. The engine reads these via Settings.from_env().

# --- LLM provider (Claude) ---
# Without a key, the engine runs the offline EchoLLM stub (good for dev/tests).
ANTHROPIC_API_KEY=

# Model selection (defaults shown). Cheap model for classify, capable model for draft.
OPENCLAW_DRAFT_MODEL=claude-opus-4-8
OPENCLAW_CLASSIFY_MODEL=claude-haiku-4-5

# --- Pipeline thresholds ---
OPENCLAW_SIM_THRESHOLD=0.30
OPENCLAW_CONF_THRESHOLD=0.55

# --- Backend: "local" (in-memory) or "django" (REST) ---
OPENCLAW_BACKEND=local
OPENCLAW_DJANGO_URL=http://localhost:8000
OPENCLAW_DJANGO_TOKEN=
